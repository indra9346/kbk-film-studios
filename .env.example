# Set these in Vercel Project Settings → Environment Variables. Never commit .env.
JWT_SECRET=replace-with-a-long-random-secret
OWNER_MASTER_PASSWORD=set-this-to-your-chosen-primary-owner-password
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Optional: enables Boom's AI response upgrade; without it, Boom uses its curated KBK FAQ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
